# Anthropic (required if DEFAULT_LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=

# OpenAI (required if DEFAULT_LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Google Gemini (required if DEFAULT_LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Supabase
# Local dev: run `npx supabase start` (needs Docker) and copy API URL + anon key
# from `npx supabase status`. Production: use the values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-vision.json

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags
DEFAULT_LLM_PROVIDER=claude
